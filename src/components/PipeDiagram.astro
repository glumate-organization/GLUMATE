---
// 데이터 파이프라인 단계별 설계도 도식 (인라인 SVG — 외부 자산 0).
// 수치·눈금 값은 일부러 넣지 않는다. 흐름의 모양만 보여주는 개념도다.
interface Props {
  step: number;
}
const { step } = Astro.props;

const sources = ['CGM 센서', '걸음', '운동', '수면'];
const metrics = [
  { label: '혈당', w: 120 },
  { label: '활동', w: 92 },
  { label: '수면', w: 106 },
];
---

<svg class="pd" viewBox="0 0 400 280" role="img" aria-label={['데이터를 모으는 도식', '기록을 시간 축에서 잇는 도식', '앞으로의 흐름을 내다보는 도식', '여러 지표를 하나의 상태로 전하는 도식'][step]}>
  {
    step === 0 && (
      <>
        {sources.map((s, i) => {
          const y = 34 + i * 60;
          return (
            <g>
              <rect class="box" x="16" y={y} width="112" height="34" rx="4" />
              <text class="lbl" x="72" y={y + 21.5} text-anchor="middle">
                {s}
              </text>
              <path class="flow" d={`M128 ${y + 17} C210 ${y + 17} 200 140 250 140`} />
            </g>
          );
        })}
        <circle class="hub" cx="304" cy="140" r="52" />
        <circle class="hub-ring" cx="304" cy="140" r="62" />
        <text class="lbl strong" x="304" y="136" text-anchor="middle">한곳에</text>
        <text class="lbl" x="304" y="154" text-anchor="middle">모은 기록</text>
      </>
    )
  }
  {
    step === 1 && (
      <>
        <line class="axis" x1="24" y1="224" x2="384" y2="224" />
        <text class="cap" x="384" y="246" text-anchor="end">시간</text>
        <path
          class="curve"
          pathLength="1"
          d="M24 176 C60 176 92 170 116 160 C146 148 152 86 184 82 C214 78 222 146 254 152 C284 158 300 120 324 118 C348 116 364 146 384 150"
        />
        <line class="tie" x1="140" y1="224" x2="140" y2="134" />
        <line class="tie" x1="262" y1="224" x2="262" y2="150" />
        <circle class="dot" cx="140" cy="134" r="5" />
        <circle class="dot" cx="262" cy="151" r="5" />
        <rect class="tag" x="112" y="232" width="56" height="24" rx="12" />
        <text class="lbl" x="140" y="248" text-anchor="middle">식사</text>
        <rect class="tag" x="234" y="232" width="56" height="24" rx="12" />
        <text class="lbl" x="262" y="248" text-anchor="middle">운동</text>
        <text class="cap" x="24" y="40">혈당의 흐름</text>
      </>
    )
  }
  {
    step === 2 && (
      <>
        <line class="axis" x1="24" y1="224" x2="384" y2="224" />
        <path class="band" d="M220 120 C270 108 320 70 384 62 L384 168 C320 160 270 136 220 120 Z" />
        <path class="curve" pathLength="1" d="M24 178 C70 178 96 150 124 146 C158 140 176 128 220 120" />
        <path class="ahead" d="M220 120 C270 122 320 114 384 115" />
        <line class="now" x1="220" y1="36" x2="220" y2="224" />
        <circle class="dot" cx="220" cy="120" r="6" />
        <rect class="tag solid" x="192" y="232" width="56" height="24" rx="12" />
        <text class="lbl on" x="220" y="248" text-anchor="middle">지금</text>
        <text class="cap" x="24" y="40">지나온 기록</text>
        <text class="cap accent" x="384" y="40" text-anchor="end">미리 보는 흐름</text>
      </>
    )
  }
  {
    step === 3 && (
      <>
        {metrics.map((m, i) => {
          const y = 66 + i * 64;
          return (
            <g>
              <text class="cap" x="20" y={y - 8}>
                {m.label}
              </text>
              <rect class="track" x="20" y={y} width="140" height="10" rx="5" />
              <rect class="fill" x="20" y={y} width={m.w} height="10" rx="5" />
              <path class="flow" d={`M168 ${y + 5} C210 ${y + 5} 210 140 236 140`} />
            </g>
          );
        })}
        <circle class="hub" cx="300" cy="140" r="58" />
        <circle class="eye" cx="282" cy="130" r="5" />
        <circle class="eye" cx="318" cy="130" r="5" />
        <path class="smile" d="M280 152 Q300 168 320 152" />
        <text class="lbl strong" x="300" y="226" text-anchor="middle">오늘의 상태</text>
      </>
    )
  }
</svg>

<style>
  .pd {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-sans);
  }
  .box,
  .tag {
    fill: var(--surface);
    stroke: var(--navy-line);
    stroke-width: 1;
  }
  .tag.solid {
    fill: var(--navy);
    stroke: var(--navy);
  }
  .lbl {
    fill: var(--text);
    font-size: 12.5px;
    font-weight: 600;
  }
  .lbl.strong {
    fill: var(--navy);
    font-size: 14px;
    font-weight: 800;
  }
  .lbl.on {
    fill: #fff;
    font-weight: 700;
  }
  .cap {
    fill: var(--text-3);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .cap.accent {
    fill: var(--navy);
  }
  .axis {
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
  .curve {
    fill: none;
    stroke: var(--navy);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .ahead {
    fill: none;
    stroke: var(--navy);
    stroke-width: 2;
    stroke-dasharray: 5 6;
    stroke-linecap: round;
  }
  .band {
    fill: var(--navy-tint);
    stroke: var(--navy-line);
    stroke-width: 1;
  }
  .now,
  .tie {
    stroke: var(--navy-line);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .dot {
    fill: var(--surface);
    stroke: var(--navy);
    stroke-width: 2;
  }
  .flow {
    fill: none;
    stroke: var(--navy);
    stroke-width: 1.4;
    stroke-dasharray: 4 6;
    opacity: 0.55;
    animation: pd-flow 2.4s linear infinite;
  }
  .hub {
    fill: var(--navy-tint);
    stroke: var(--navy);
    stroke-width: 1.6;
  }
  .hub-ring {
    fill: none;
    stroke: var(--navy-line);
    stroke-width: 1;
    stroke-dasharray: 2 4;
  }
  .track {
    fill: var(--surface-2);
    stroke: var(--rule);
  }
  .fill {
    fill: var(--navy);
    opacity: 0.85;
  }
  .eye {
    fill: var(--navy);
  }
  .smile {
    fill: none;
    stroke: var(--navy);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  @keyframes pd-flow {
    to {
      stroke-dashoffset: -20;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow {
      animation: none;
    }
  }
</style>
