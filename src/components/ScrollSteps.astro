---
// 스크롤 단계 — 스크롤하면 왼쪽 단계가 차례로 켜지고, 오른쪽에 고정된 설계도 도식이 단계에 맞춰 바뀐다.
// 외부 의존 없이 IntersectionObserver + scroll 하나. JS 가 없으면 모든 단계 글이 또렷하게 보이고 첫 도식이 고정된다.
// 좁은 화면(900px 미만)에서는 고정 도식 대신 단계마다 도식을 바로 아래에 둔다.
import PipeDiagram from './PipeDiagram.astro';

interface Props {
  items: { en: string; title: string; desc: string }[];
}
const { items } = Astro.props;
const no = (i: number) => String(i + 1).padStart(2, '0');
---

<div class="steps" data-steps>
  <ol class="steps-list">
    {
      items.map((t, i) => (
        <li class:list={['step', { 'is-active': i === 0 }]} data-step={i}>
          <p class="step-en">
            <span class="step-num">{no(i)}</span>
            {t.en}
          </p>
          <h3>{t.title}</h3>
          <p class="step-desc">{t.desc}</p>
          <div class="step-inline" aria-hidden="true">
            <PipeDiagram step={i} />
          </div>
        </li>
      ))
    }
  </ol>

  <div class="stage">
    <div class="stage-frame">
      <div class="stage-bar" aria-hidden="true">
        {
          items.map((_, i) => (
            <span class:list={['stage-fig', { 'is-active': i === 0 }]} data-fig={i}>
              FIG. {no(i)}
            </span>
          ))
        }
        <ol class="stage-dots">
          {items.map((_, i) => <li class:list={{ 'is-active': i === 0 }} data-dot={i} />)}
        </ol>
      </div>
      <div class="stage-screens">
        {
          items.map((_, i) => (
            <div class:list={['stage-screen', { 'is-active': i === 0 }]} data-screen={i}>
              <PipeDiagram step={i} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-steps]').forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const groups = [
      steps,
      [...root.querySelectorAll<HTMLElement>('[data-screen]')],
      [...root.querySelectorAll<HTMLElement>('[data-dot]')],
      [...root.querySelectorAll<HTMLElement>('[data-fig]')],
    ];
    const list = root.querySelector<HTMLElement>('.steps-list')!;
    root.classList.add('is-live');

    const activate = (i: number) =>
      groups.forEach((g) => g.forEach((el, j) => el.classList.toggle('is-active', i === j)));

    // 화면 가운데 띠를 지나는 단계를 활성으로
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) activate(Number((e.target as HTMLElement).dataset.step));
        }),
      { rootMargin: '-45% 0px -45% 0px' }
    );
    steps.forEach((s) => io.observe(s));

    // 진행선: 목록 위끝이 화면 가운데에 닿을 때 0, 아래끝이 닿을 때 1
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = list.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight / 2 - r.top) / r.height));
      list.style.setProperty('--progress', p.toFixed(3));
    };
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );
    update();
  });
</script>

<style>
  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-9);
    align-items: start;
  }
  .steps-list {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  /* 왼쪽 진행선 — 지나는 만큼 위에서 아래로 차오른다 */
  .steps-list::before,
  .steps-list::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--rule-strong);
  }
  .steps-list::after {
    width: 2px;
    left: -0.5px;
    background: var(--navy);
    transform-origin: top;
    transform: scaleY(var(--progress, 1));
  }
  .step {
    min-height: 52vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--sp-7) 0 var(--sp-7) var(--sp-7);
    transition: opacity 0.5s var(--ease);
  }
  .step-en {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    color: var(--navy);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .step-num {
    font-size: var(--fs-h4);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
  .step h3 {
    margin-top: var(--sp-3);
    font-size: var(--fs-h2);
    letter-spacing: -0.04em;
  }
  .step-desc {
    margin-top: var(--sp-4);
    max-width: 480px;
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
  }
  .step-inline {
    display: none;
  }

  /* ── 오른쪽 고정 도식 ── */
  .stage {
    position: sticky;
    top: calc(var(--nav-h) + var(--sp-7));
  }
  .stage-frame {
    background-color: var(--surface);
    background-image: var(--grid-light);
    background-size: 32px 32px;
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-soft);
  }
  .stage-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-3) var(--sp-5);
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
  }
  .stage-fig {
    display: none;
    color: var(--text-3);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    font-variant-numeric: tabular-nums;
  }
  .stage-fig.is-active {
    display: block;
  }
  .stage-dots {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 6px;
  }
  .stage-dots li {
    width: 6px;
    height: 6px;
    border-radius: var(--r-pill);
    background: var(--rule-strong);
    transition: width 0.35s var(--ease), background 0.35s var(--ease);
  }
  .stage-dots li.is-active {
    width: 22px;
    background: var(--navy);
  }
  .stage-screens {
    display: grid;
    padding: var(--sp-7) var(--sp-6);
  }
  .stage-screen {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.45s var(--ease), transform 0.6s var(--ease);
  }
  .stage-screen.is-active {
    opacity: 1;
    transform: none;
  }

  /* JS 가 붙은 뒤에만 비활성 단계를 흐리게 — JS 없이도 모든 글이 또렷하다 */
  .steps.is-live .step:not(.is-active) {
    opacity: 0.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .step,
    .stage-screen,
    .stage-dots li {
      transition: none;
    }
    .stage-screen {
      transform: none;
    }
  }

  @media (max-width: 899px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .stage {
      display: none;
    }
    .step {
      min-height: 0;
      padding: var(--sp-6) 0 var(--sp-6) var(--sp-5);
    }
    .step-inline {
      display: block;
      margin-top: var(--sp-5);
      padding: var(--sp-5);
      background-color: var(--surface);
      background-image: var(--grid-light);
      background-size: 32px 32px;
      border: 1px solid var(--rule);
      border-radius: var(--r-md);
    }
    .steps.is-live .step:not(.is-active) {
      opacity: 1;
    }
  }
</style>
