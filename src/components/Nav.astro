---
import { Image } from 'astro:assets';
import { logos } from '../lib/assets';
import { url } from '../lib/url';

const path = Astro.url.pathname;
const items = [
  { href: '/about', label: '회사 소개' },
  { href: '/technology', label: '기술' },
  { href: '/products', label: '제품' },
  { href: '/contact', label: '문의' },
];
const isActive = (href: string) => path === href || path === `${href}/`;
---

<header class="nav">
  <div class="container nav-inner">
    <a href={url('/')} class="brand" aria-label="글루메이트 홈">
      <Image
        src={logos.horizontal}
        alt="글루메이트 GLUMATE"
        width={220}
        height={40}
        densities={[1, 2]}
        loading="eager"
      />
    </a>

    <nav class="nav-links" aria-label="주요 메뉴">
      {
        items.map((item) => (
          <a
            href={url(item.href)}
            class:list={['nav-link', { 'is-active': isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href={url('/contact')} class="btn btn-primary nav-cta">문의하기</a>
  </div>

  <!-- 페이지 스크롤 진행률 -->
  <div class="progress" aria-hidden="true"><div class="progress-bar"></div></div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    /* 진행바가 하단 경계선 위에 얹힌다 */
    isolation: isolate;
    background: rgba(246, 248, 251, 0.88);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--rule);
  }
  .nav-inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: var(--sp-7);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }
  .brand :global(img) {
    height: 26px;
    width: auto;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-right: auto;
  }
  .nav-link {
    position: relative;
    padding: 8px 14px;
    color: var(--text-2);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    border-radius: var(--r-sm);
    transition: color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .nav-link:hover {
    color: var(--navy);
    background: var(--navy-tint);
  }
  .nav-link.is-active {
    color: var(--navy);
  }
  .nav-link.is-active::after {
    content: "";
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 1px;
    height: 2px;
    background: var(--navy);
    border-radius: 2px;
  }
  .nav-cta {
    flex: 0 0 auto;
    padding: 10px 20px;
    font-size: 14px;
  }

  @media (max-width: 900px) {
    .nav-inner {
      gap: var(--sp-4);
    }
    .nav-cta {
      display: none;
    }
    .nav-link {
      padding: 8px 10px;
      font-size: 14px;
    }
  }
  @media (max-width: 640px) {
    .nav-inner {
      height: auto;
      flex-wrap: wrap;
      padding-top: 14px;
      padding-bottom: 10px;
      gap: 10px;
    }
    .brand {
      width: 100%;
    }
    .nav-links {
      width: 100%;
      margin: 0;
      gap: 2px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav-links::-webkit-scrollbar {
      display: none;
    }
    .nav-link {
      white-space: nowrap;
    }
  }
</style>
