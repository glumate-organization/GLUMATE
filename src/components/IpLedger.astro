---
// 지식재산 현황 — 왼쪽 총계, 오른쪽 종류별 칸.
// 출원과 등록은 모두 회사가 쌓은 지식재산이므로 같은 무게(같은 색 칸)로 보여주고,
// 상태는 각 칸 아래 작은 글씨로만 구분한다. 특허를 등록된 권리처럼 보이게 하지 않는다.
// 화면에 들어오면 칸이 왼쪽부터 차례로 찍힌다 (CSS 스크롤 타임라인, JS 0). 미지원·모션 줄이기에선 완성 상태.
import { ipPortfolio, ipTotals } from '../lib/credentials';

let n = 0;
const groups = ipPortfolio.items.map((item) => ({
  ...item,
  cells: Array.from({ length: item.count }, () => n++),
}));
---

<div class="ip">
  <div class="ip-total">
    <p class="ip-kicker">Intellectual Property</p>
    <p class="ip-num"><span>{ipTotals.all}</span>건</p>
    <p class="ip-lead">기술과 브랜드, 캐릭터까지 지식재산으로 지켜 두었습니다.</p>
  </div>

  <ul class="ip-groups">
    {
      groups.map((g) => (
        <li class="ip-group" style={`--n:${g.count}`}>
          <div class="ip-cells" aria-hidden="true">
            {g.cells.map((c) => (
              <span class="ip-cell" style={`--c:${c}`} />
            ))}
          </div>
          <p class="ip-kind">
            {g.kind} <b>{g.count}</b>
            <span class="ip-status">{g.status === 'registered' ? '등록' : '출원'}</span>
          </p>
          {g.scope && <p class="ip-scope">{g.scope}</p>}
        </li>
      ))
    }
  </ul>

  <p class="ip-foot">
    <span>특허·상표·디자인은 출원하여 심사가 진행 중이며, 저작권은 등록을 마쳤습니다.</span>
    <span class="ip-asof">{ipPortfolio.asOf}</span>
  </p>
</div>

<style>
  .ip {
    display: grid;
    grid-template-columns: minmax(0, 0.32fr) minmax(0, 1fr);
    gap: var(--sp-7);
    align-items: center;
    padding: var(--sp-7);
    background-color: var(--surface);
    background-image: var(--grid-light);
    background-size: 32px 32px;
    border: 1px solid var(--rule);
    border-top: 3px solid var(--navy);
    border-radius: 0 0 var(--r-md) var(--r-md);
  }

  .ip-kicker {
    color: var(--navy);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .ip-num {
    margin-top: var(--sp-2);
    color: var(--navy);
    font-size: var(--fs-h4);
    font-weight: 700;
    line-height: 1;
  }
  .ip-num span {
    font-size: var(--fs-h1);
    font-weight: 800;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .ip-lead {
    margin-top: var(--sp-3);
    color: var(--text-2);
    font-size: var(--fs-sm);
    line-height: 1.7;
  }

  .ip-groups {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--sp-5);
  }
  .ip-group {
    flex: var(--n) 1 0;
    min-width: 0;
  }
  .ip-cells {
    display: flex;
    gap: var(--sp-1);
  }
  .ip-cell {
    display: block;
    flex: 1;
    height: 28px;
    border-radius: 2px;
    background: var(--navy);
  }
  .ip-kind {
    margin-top: var(--sp-3);
    padding-top: var(--sp-2);
    border-top: 1px solid var(--rule-strong);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px var(--sp-2);
    color: var(--text);
    font-size: var(--fs-sm);
    font-weight: 700;
    white-space: nowrap;
  }
  .ip-kind b {
    color: var(--navy);
    font-size: var(--fs-h4);
    font-variant-numeric: tabular-nums;
  }
  .ip-status {
    color: var(--text-3);
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  .ip-scope {
    margin-top: var(--sp-1);
    color: var(--text-2);
    font-size: var(--fs-xs);
    line-height: 1.6;
  }

  .ip-foot {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-5);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--rule);
    color: var(--text-3);
    font-size: var(--fs-xs);
  }

  @keyframes stamp {
    from {
      opacity: 0;
      transform: scaleY(0.2);
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .ip-groups {
        view-timeline-name: --ip;
      }
      .ip-cell {
        transform-origin: bottom;
        animation: stamp linear both;
        animation-timeline: --ip;
        animation-range: entry calc(20% + var(--c) * 4%) entry calc(35% + var(--c) * 4%);
      }
    }
  }

  @media (max-width: 900px) {
    .ip {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
      padding: var(--sp-6) var(--sp-5);
    }
  }
  @media (max-width: 560px) {
    .ip-groups {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-5) var(--sp-4);
    }
  }
</style>
