---
import Layout from '../layouts/Layout.astro';
import { company } from '../lib/company';
import { links } from '../lib/links';

const title = '문의 — 글루메이트 (GLUMATE)';
const description =
  '글루메이트 연락처입니다. 이메일과 카카오톡 채널로 문의하실 수 있으며, 사무실은 대전 한남대학교 캠퍼스혁신파크에 있습니다.';

const mapQuery = encodeURIComponent('한남대학교 캠퍼스혁신파크');

// 연락처는 이 한 덩어리가 전부다. 문의 유형 안내·응대 약속 같은 군더더기는 두지 않는다.
const rows = [
  {
    label: '이메일',
    value: company.email,
    href: `mailto:${company.email}`,
  },
  {
    label: '카카오톡 채널',
    value: '글루밍 채널',
    href: links.kakaoChannel,
    external: true,
  },
  {
    label: '주소',
    value: company.address,
    href: `https://map.naver.com/p/search/${mapQuery}`,
    external: true,
    linkLabel: '지도에서 보기',
  },
];
---

<Layout title={title} description={description}>
  <section class="page">
    <div class="page-grid-bg" aria-hidden="true"></div>
    <div class="container">
      <span class="eyebrow intro" style="--i:0">Contact</span>
      <h1 class="page-title">
        <span class="line" style="--i:0"><span>문의</span></span>
      </h1>

      <div class="card intro" style="--i:1">
        <dl>
          {
            rows.map((r) => (
              <div class="row">
                <dt>{r.label}</dt>
                <dd>
                  {r.linkLabel ? (
                    <>
                      <span class="val">{r.value}</span>
                      <a
                        class="sub-link"
                        href={r.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {r.linkLabel} ↗
                      </a>
                    </>
                  ) : (
                    <a
                      class="val val-link"
                      href={r.href}
                      {...r.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                    >
                      {r.value}
                      {r.external && ' ↗'}
                    </a>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page {
    position: relative;
    padding: clamp(56px, 7vw, 92px) 0 clamp(72px, 9vw, 128px);
    overflow: hidden;
  }
  .page-grid-bg {
    position: absolute;
    inset: 0;
    background-image: var(--grid-light);
    background-size: 64px 64px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 70%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 70%);
    pointer-events: none;
  }
  .page .container {
    position: relative;
  }
  .page-title {
    font-size: var(--fs-h1);
    letter-spacing: -0.042em;
  }

  .card {
    margin-top: var(--sp-8);
    max-width: 620px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--navy);
    border-radius: 0 0 var(--r-md) var(--r-md);
    padding: 4px clamp(20px, 3vw, 32px);
  }
  .card dl {
    margin: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: var(--sp-5);
    align-items: baseline;
    padding: 22px 0;
  }
  .row + .row {
    border-top: 1px solid var(--rule);
  }
  .row dt {
    color: var(--text-3);
    font-size: 13px;
    font-weight: 600;
  }
  .row dd {
    margin: 0;
  }
  .val {
    display: block;
    color: var(--text);
    font-size: 16.5px;
    font-weight: 600;
    line-height: 1.6;
    word-break: keep-all;
  }
  .val-link {
    color: var(--navy);
    transition: color var(--dur-1) var(--ease);
  }
  .val-link:hover {
    color: var(--navy-lit);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sub-link {
    display: inline-block;
    margin-top: 10px;
    color: var(--navy-lit);
    font-size: 13.5px;
    font-weight: 600;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
