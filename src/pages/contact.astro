---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import { company } from '../lib/company';
import { links } from '../lib/links';

const title = '문의 — 글루메이트 (GLUMATE)';
const description =
  '글루메이트에 문의하실 수 있는 창구와 찾아오시는 길을 안내합니다. 이메일과 카카오톡 채널로 연락하실 수 있으며, 사무실은 대전 한남대학교 캠퍼스혁신파크에 있습니다.';

const mapQuery = encodeURIComponent('한남대학교 캠퍼스혁신파크');

const channels = [
  {
    label: '이메일',
    value: company.email,
    href: `mailto:${company.email}`,
    desc: '제휴·협업·채용·언론 문의 등 모든 문의를 받습니다. 가장 확실한 창구입니다.',
    cta: '메일 보내기',
  },
  {
    label: '카카오톡 채널',
    value: '글루밍 채널',
    href: links.kakaoChannel,
    desc: '앱 사용 중 겪으신 문제나 짧은 질문은 채팅으로 편하게 남겨주세요.',
    cta: '채널로 문의하기',
    external: true,
  },
];

const topics = [
  {
    title: '제품·서비스 문의',
    body: '글루밍 사용 중 겪으신 문제, 기능 제안, 계정·결제 관련 문의는 카카오톡 채널이 가장 빠릅니다.',
  },
  {
    title: '제휴 · 협업',
    body: '헬스케어 데이터, 콘텐츠, 유통, 연구 협력 등 함께할 수 있는 일이라면 언제든 이메일로 제안해 주세요.',
  },
  {
    title: '채용',
    body: '공고는 준비되는 대로 이곳에 올립니다. 그 전이라도 함께 일하고 싶은 이유를 이메일로 보내주시면 반갑게 읽겠습니다.',
  },
  {
    title: '개인정보 · 권리 행사',
    body: '내 정보의 열람·정정·삭제, 처리 정지 요청은 이메일로 접수하며, 접수 순서대로 처리해 드립니다.',
  },
];
---

<Layout title={title} description={description}>
  <section class="page-head">
    <div class="head-grid-bg" aria-hidden="true"></div>
    <div class="container">
      <span class="eyebrow intro" style="--i:0">Contact — 문의</span>
      <h1 class="page-title">
        <span class="line" style="--i:0"><span>사람이 읽고,</span></span>
        <span class="line" style="--i:1"><span class="accent">사람이 답합니다</span></span>
      </h1>
      <p class="page-lead intro" style="--i:1">
        자동 응답으로 돌려보내지 않습니다. 보내주신 내용은 담당자가 직접 읽고,
        확인하는 대로 답변드립니다.
      </p>
    </div>
  </section>

  <!-- ─── 연락 창구 ────────────────────────────────────── -->
  <section class="section channels-section">
    <div class="container">
      <div class="channels" data-reveal="stagger">
        {
          channels.map((c) => (
            <article class="channel">
              <span class="channel-label">{c.label}</span>
              <p class="channel-value">{c.value}</p>
              <p class="channel-desc">{c.desc}</p>
              <a
                class="btn btn-primary channel-cta"
                href={c.href}
                {...c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
              >
                {c.cta}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ─── 문의 유형 ────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="01 — What to Ask" variant="split">
        어떤 이야기든 좋습니다
        <Fragment slot="sub">
          어디로 보내야 할지 헷갈리신다면 이메일로 보내주세요. 저희가 알맞은 담당자에게 전달합니다.
        </Fragment>
      </SectionHead>

      <div class="cells cells-2" data-reveal="stagger">
        {
          topics.map((t, i) => (
            <article class="cell">
              <span class="cell-index">{String(i + 1).padStart(2, '0')}</span>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ─── 오시는 길 ────────────────────────────────────── -->
  <section class="section visit-section">
    <div class="container">
      <SectionHead eyebrow="02 — Visit" variant="split">
        찾아오시는 길
        <Fragment slot="sub">
          사무실은 한남대학교 캠퍼스혁신파크 안에 있습니다.
          방문 전에 미리 연락 주시면 준비해 두겠습니다.
        </Fragment>
      </SectionHead>

      <div class="visit" data-reveal>
        <div class="visit-card">
          <span class="visit-label">주소</span>
          <p class="visit-address">{company.address}</p>
          <p class="visit-sub">{company.addressBuilding}</p>
          <div class="visit-actions">
            <a
              class="btn btn-ghost"
              href={`https://map.naver.com/p/search/${mapQuery}`}
              target="_blank"
              rel="noopener noreferrer">네이버 지도 ↗</a
            >
            <a
              class="btn btn-ghost"
              href={`https://map.kakao.com/?q=${mapQuery}`}
              target="_blank"
              rel="noopener noreferrer">카카오맵 ↗</a
            >
          </div>
        </div>

        <dl class="visit-spec">
          <div>
            <dt>상호</dt>
            <dd>{company.nameKo} ({company.nameEn})</dd>
          </div>
          <div>
            <dt>대표자</dt>
            <dd>{company.ceo}</dd>
          </div>
          <div>
            <dt>하는 일</dt>
            <dd>{company.bizItem}</dd>
          </div>
          <div>
            <dt>이메일</dt>
            <dd><a class="link" href={`mailto:${company.email}`}>{company.email}</a></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-head {
    position: relative;
    padding: clamp(56px, 7vw, 92px) 0 clamp(40px, 5vw, 64px);
    overflow: hidden;
  }
  .head-grid-bg {
    position: absolute;
    inset: 0;
    background-image: var(--grid-light);
    background-size: 64px 64px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
    pointer-events: none;
  }
  .page-head .container {
    position: relative;
  }
  .page-title {
    font-size: var(--fs-h1);
    letter-spacing: -0.042em;
  }
  .page-title .accent {
    color: var(--navy);
  }
  .page-lead {
    margin-top: var(--sp-6);
    max-width: 620px;
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
  }

  /* ── 연락 창구 ────────────────────────────────────── */
  .channels-section {
    padding-top: 0;
  }
  .channels {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .channel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(26px, 3.2vw, 38px);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--navy);
    border-radius: 0 0 var(--r-md) var(--r-md);
  }
  .channel-label {
    color: var(--text-3);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .channel-value {
    margin-top: 8px;
    color: var(--navy);
    font-size: clamp(18px, 2.1vw, 24px);
    font-weight: 800;
    letter-spacing: -0.025em;
    word-break: break-all;
  }
  .channel-desc {
    margin-top: 14px;
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.75;
  }
  .channel-cta {
    margin-top: auto;
    padding-top: 12px;
    padding-bottom: 12px;
  }
  .channel-desc + .channel-cta {
    margin-top: var(--sp-6);
  }

  .cells-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  /* ── 오시는 길 ────────────────────────────────────── */
  .visit-section {
    background: var(--surface-2);
    border-top: 1px solid var(--rule);
  }
  .visit {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 24px;
    align-items: start;
  }
  .visit-card {
    padding: clamp(28px, 3.4vw, 40px);
    background: var(--navy);
    border-radius: var(--r-lg);
    background-image: var(--grid-dark);
    background-size: 48px 48px;
  }
  .visit-label {
    color: var(--on-dark-2);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .visit-address {
    margin-top: 12px;
    color: #fff;
    font-size: clamp(18px, 2.2vw, 24px);
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: -0.03em;
  }
  .visit-sub {
    margin-top: 10px;
    color: var(--on-dark-2);
    font-size: 14.5px;
  }
  .visit-actions {
    margin-top: var(--sp-6);
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .visit-actions .btn {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.28);
    color: #fff;
  }
  .visit-actions .btn:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .visit-spec {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    padding: 8px 22px;
  }
  .visit-spec > div {
    padding: 16px 0;
  }
  .visit-spec > div + div {
    border-top: 1px solid var(--rule);
  }
  .visit-spec dt {
    color: var(--text-3);
    font-size: 12.5px;
    font-weight: 600;
  }
  .visit-spec dd {
    margin: 4px 0 0;
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
    word-break: break-all;
  }
  .link {
    color: var(--navy-lit);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 860px) {
    .channels {
      grid-template-columns: 1fr;
    }
    .cells-2 {
      grid-template-columns: 1fr;
    }
    .visit {
      grid-template-columns: 1fr;
    }
  }
</style>
