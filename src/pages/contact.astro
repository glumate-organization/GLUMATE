---
import Layout from '../layouts/Layout.astro';
import { company } from '../lib/company';
import { mailto } from '../lib/mail';

const title = '문의 — 글루메이트 (GLUMATE)';
const description =
  '글루메이트 문의는 이메일(glumate@glumate.org)로 받습니다. 사무실은 대전 한남대학교 캠퍼스혁신파크에 있습니다.';

const mapQuery = encodeURIComponent('한남대학교 캠퍼스혁신파크');

// 문의 창구는 메일 하나다. 유형마다 제목을 미리 채워 두어 받는 쪽에서 바로 분류된다.
const topics = [
  { label: '제휴 · 협업', desc: '기술 협력, 데이터 연동, 공동 사업 제안', subject: '제휴·협업 문의' },
  { label: '투자 · 언론', desc: '회사 소개 자료, 인터뷰와 취재 요청', subject: '투자·언론 문의' },
  { label: '그 밖의 문의', desc: '어디에 해당할지 모르겠다면 여기로', subject: '일반 문의' },
];
---

<Layout title={title} description={description}>
  <section class="page">
    <div class="page-grid-bg" aria-hidden="true"></div>
    <div class="container">
      <span class="eyebrow intro" style="--i:0">Contact</span>
      <h1 class="page-title">
        <span class="line" style="--i:0"><span>문의</span></span>
      </h1>
      <p class="page-lead intro" style="--i:1">
        {company.email}로 문의 메일을 보내 주시면 빠르게 답해 드릴게요.
      </p>

      <div class="grid intro" style="--i:2">
        <div class="mail-card">
          <p class="mail-label">이메일</p>
          <a class="mail-addr" href={mailto('문의')}>{company.email}</a>
          <a class="btn btn-primary" href={mailto('문의')}>메일 보내기</a>

          <div class="addr">
            <p class="mail-label">주소</p>
            <p class="addr-val">{company.address}</p>
            <a
              class="sub-link"
              href={`https://map.naver.com/p/search/${mapQuery}`}
              target="_blank"
              rel="noopener noreferrer">지도에서 보기 ↗</a
            >
          </div>
        </div>

        <ul class="topics" aria-label="문의 유형">
          {
            topics.map((t) => (
              <li>
                <a class="topic" href={mailto(t.subject)}>
                  <span class="topic-text">
                    <span class="topic-label">{t.label}</span>
                    <span class="topic-desc">{t.desc}</span>
                  </span>
                  <span class="topic-go">메일 쓰기 →</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page {
    position: relative;
    padding: clamp(56px, 7vw, 92px) 0 clamp(72px, 9vw, 128px);
    overflow: hidden;
  }
  .page-grid-bg {
    position: absolute;
    inset: 0;
    background-image: var(--grid-light);
    background-size: 64px 64px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 70%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 70%);
    pointer-events: none;
  }
  .page .container {
    position: relative;
  }
  .page-title {
    font-size: var(--fs-h1);
    letter-spacing: -0.042em;
  }
  .page-lead {
    margin-top: var(--sp-5);
    max-width: var(--measure);
    color: var(--text-2);
    font-size: var(--fs-lead);
  }

  .grid {
    margin-top: var(--sp-8);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--sp-6);
    align-items: start;
  }

  .mail-card {
    padding: var(--sp-7);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--navy);
    border-radius: 0 0 var(--r-md) var(--r-md);
  }
  .mail-label {
    color: var(--text-3);
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  .mail-addr {
    display: block;
    margin: var(--sp-2) 0 var(--sp-5);
    color: var(--navy);
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.03em;
    word-break: break-all;
  }
  .mail-addr:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .addr {
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule);
  }
  .addr-val {
    margin-top: var(--sp-2);
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.7;
  }
  .sub-link {
    display: inline-block;
    margin-top: var(--sp-2);
    color: var(--navy-lit);
    font-size: var(--fs-xs);
    font-weight: 600;
    border-bottom: 1px solid currentColor;
  }

  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--text);
  }
  .topics li {
    border-bottom: 1px solid var(--rule);
  }
  .topic {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    padding: var(--sp-5) var(--sp-2);
    transition: background var(--dur-1) var(--ease);
  }
  .topic:hover {
    background: var(--surface);
  }
  .topic-text {
    display: grid;
    gap: var(--sp-1);
  }
  .topic-label {
    color: var(--text);
    font-size: var(--fs-h4);
    font-weight: 700;
  }
  .topic-desc {
    color: var(--text-2);
    font-size: var(--fs-sm);
  }
  .topic-go {
    flex: none;
    color: var(--navy);
    font-size: var(--fs-sm);
    font-weight: 700;
    transition: transform var(--dur-1) var(--ease);
  }
  .topic:hover .topic-go {
    transform: translateX(3px);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .mail-card {
      padding: var(--sp-6) var(--sp-5);
    }
  }
</style>
