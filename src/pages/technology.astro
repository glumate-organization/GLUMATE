---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
import SectionHead from '../components/SectionHead.astro';
import ScrollSteps from '../components/ScrollSteps.astro';
import IpLedger from '../components/IpLedger.astro';
import { ipTotals, patentAreas, patentSummary } from '../lib/credentials';
import { links } from '../lib/links';

const title = '기술 — 글루메이트 (GLUMATE)';
const description =
  '글루메이트는 연속혈당측정 데이터를 해석하는 기술로 특허 3건을 출원했고, 상표·디자인 출원과 글루밍즈 캐릭터 저작권 등록까지 지식재산을 갖춰 가고 있습니다. ㈜아이센스와 개발 파트너십을 맺었습니다.';

// 데이터가 지나는 길 — 우리가 실제로 만든 흐름. 단계마다 무엇을, 어떻게 하는지 구체적으로 적는다.
const pipeline = [
  {
    en: 'Data Integration',
    title: '센서 값과 생활 기록을 하나의 시간 축에',
    desc: '㈜아이센스와 협력해 케어센스 에어의 연속혈당 측정값을 클라우드 API로 받아오고, 걸음·운동·수면 기록을 같은 시간 축에 맞춰 정렬합니다. 측정 간격이 다른 데이터는 자체 전처리를 거쳐 한 흐름으로 다룹니다.',
    points: ['CGM 클라우드 연동', '건강 앱 데이터', '자체 전처리'],
  },
  {
    en: 'Context',
    title: '행동과 혈당 흐름의 관계를 개인별로',
    desc: '혈당 값 하나만 보지 않고, 식사와 운동 기록을 시간 축에서 맞물려 어떤 행동 뒤에 흐름이 어떻게 달라졌는지 사람마다 따로 쌓아 갑니다.',
    points: ['식사 기록', '운동 강도', '개인별 패턴'],
  },
  {
    en: 'Prediction',
    title: '선택하기 전에 보는 단기 예측',
    desc: '최근 데이터와 운동 강도(METs)를 함께 계산해, 선택지마다 앞으로의 흐름이 어떻게 달라질지 미리 그려 봅니다. 짧게 착용한 데이터로도 개인에게 맞춘 예측을 만드는 기술은 특허를 출원했습니다.',
    points: ['개인 맞춤 예측', '운동 강도 반영', '특허 출원'],
  },
  {
    en: 'Interpretation',
    title: '여러 지표를 하나의 상태로 읽기 쉽게',
    desc: '혈당·활동·수면 같은 여러 지표를 하나의 건강 상태 점수로 합치고, 숫자 대신 글루밍즈 캐릭터의 표정과 짧은 문장으로 오늘의 상태를 전합니다.',
    points: ['건강 상태 점수', '캐릭터 표현', '특허 출원'],
  },
];
---

<Layout title={title} description={description}>
  <!-- ─── 헤더 ─────────────────────────────────────────── -->
  <section class="page-head">
    <div class="head-grid-bg" aria-hidden="true"></div>
    <div class="container">
      <span class="eyebrow intro" style="--i:0">Technology · 기술</span>
      <h1 class="page-title">
        <span class="line" style="--i:0"><span>혈당 데이터를</span></span>
        <span class="line" style="--i:1"><span class="accent">읽는 방법을 만듭니다</span></span>
      </h1>
      <p class="page-lead intro" style="--i:1">
        같은 센서 값을 받아도, 그것을 어떻게 해석하느냐에 따라 사용자에게 남는 것이 달라집니다.
        글루메이트는 그 해석하는 방법에 대해 특허 {patentSummary.count}건을 출원했습니다.
      </p>
      <div class="head-tags intro" style="--i:2">
        <span class="tag">{patentSummary.filedLabel}</span>
        <span class="tag">{patentSummary.statusLabel}</span>
        <span class="tag">지식재산 {ipTotals.all}건</span>
        <span class="tag">㈜아이센스 개발 파트너십</span>
      </div>
    </div>
  </section>

  <!-- ─── 특허 출원 영역 ───────────────────────────────── -->
  <section class="section patents">
    <div class="patents-grid-bg" aria-hidden="true"></div>
    <div class="container">
      <SectionHead eyebrow="01 · Patents Pending" variant="split" light>
        출원한 기술 세 가지
        <Fragment slot="sub">
          아래는 출원한 기술의 영역을 간단히 옮긴 것입니다.
          심사가 진행 중이므로 구체적인 청구 범위는 공개하지 않습니다.
        </Fragment>
      </SectionHead>

      <div class="patent-list" data-reveal="stagger">
        {
          patentAreas.map((p) => (
            <article class="patent">
              <span class="patent-no">{p.no}</span>
              <div class="patent-body">
                <span class="patent-area">{p.area}</span>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </article>
          ))
        }
      </div>

      <p class="patent-note">{patentSummary.note}</p>
    </div>
  </section>

  <!-- ─── 지식재산 ─────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="02 · Intellectual Property" variant="split">
        기술과 브랜드를 함께 지킵니다
        <Fragment slot="sub">
          기술은 특허로, 이름과 얼굴은 상표와 디자인으로, 글루밍즈 캐릭터는 저작권으로 지켜 두었습니다.
        </Fragment>
      </SectionHead>
      <div data-reveal>
        <IpLedger />
      </div>
    </div>
  </section>

  <!-- ─── 데이터가 지나는 길 ───────────────────────────── -->
  <section class="section pipe-section">
    <div class="container">
      <SectionHead eyebrow="03 · How It Works" variant="split">
        데이터가 지나는 길
        <Fragment slot="sub">
          센서에서 나온 값이 사용자의 화면에 닿기까지 거치는 네 단계입니다. 스크롤을 내리면 단계마다 오른쪽 도식이 바뀝니다.
        </Fragment>
      </SectionHead>
      <ScrollSteps items={pipeline} />
    </div>
  </section>

  <!-- ─── 경계 ─────────────────────────────────────────── -->
  <section class="section-tight boundary">
    <div class="container boundary-inner" data-reveal>
      <h2 class="boundary-title">기술이 할 수 있는 일과 없는 일</h2>
      <p class="boundary-body">
        글루메이트의 기술은 생활습관 관리를 돕는 웰니스 영역에 있습니다.
        질병을 진단하거나 치료하지 않고, 의료진의 진료를 대체하지 않으며, 특정 수치를 보장하지
        않습니다. 예측은 참고를 위한 것이며, 건강에 관한 판단은 의료 전문가와 상의하시기 바랍니다.
      </p>
      <div class="boundary-actions">
        <a href={url('/products')} class="btn btn-primary">제품에서 확인하기</a>
        <a
          href={links.glumingSite}
          class="btn btn-ghost"
          target="_blank"
          rel="noopener noreferrer">글루밍 웹사이트 ↗</a
        >
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── 페이지 헤더 ──────────────────────────────────── */
  .page-head {
    position: relative;
    padding: clamp(56px, 7vw, 92px) 0 clamp(48px, 6vw, 76px);
    overflow: hidden;
  }
  .head-grid-bg {
    position: absolute;
    inset: 0;
    background-image: var(--grid-light);
    background-size: 64px 64px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
    pointer-events: none;
  }
  .page-head .container {
    position: relative;
  }
  .page-title {
    font-size: var(--fs-h1);
    letter-spacing: -0.042em;
  }
  .page-title .accent {
    color: var(--navy);
  }
  .page-lead {
    margin-top: var(--sp-6);
    max-width: 660px;
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
  }
  .head-tags {
    margin-top: var(--sp-6);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    padding: 7px 14px;
    border: 1px solid var(--navy-line);
    border-radius: var(--r-pill);
    background: var(--navy-tint);
    color: var(--navy);
    font-size: 12.5px;
    font-weight: 700;
  }

  /* ── 특허 ─────────────────────────────────────────── */
  .patents {
    position: relative;
    background: var(--navy-ink);
    overflow: hidden;
  }
  .patents-grid-bg {
    position: absolute;
    inset: 0;
    background-image: var(--grid-dark);
    background-size: 64px 64px;
  }
  .patents .container {
    position: relative;
  }
  .patent-list {
    border-top: 1px solid var(--rule-dark);
  }
  .patent {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: clamp(16px, 3vw, 40px);
    padding: clamp(26px, 3vw, 38px) 0;
    border-bottom: 1px solid var(--rule-dark);
  }
  .patent-no {
    color: rgba(168, 189, 218, 0.55);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
    padding-top: 4px;
  }
  .patent-area {
    display: inline-block;
    padding: 4px 11px;
    border: 1px solid var(--rule-dark);
    border-radius: var(--r-pill);
    color: var(--on-dark-accent);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .patent-body h3 {
    margin-top: 14px;
    color: #fff;
    font-size: clamp(20px, 2.2vw, 26px);
  }
  .patent-body p {
    margin-top: 12px;
    max-width: 720px;
    color: var(--on-dark-2);
    font-size: 15px;
    line-height: 1.85;
  }
  .patent-note {
    margin-top: var(--sp-6);
    color: rgba(168, 189, 218, 0.75);
    font-size: 13px;
  }

  /* ── 파이프라인 ───────────────────────────────────── */
  .pipe-section {
    background: var(--surface-2);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  /* ── 경계 ─────────────────────────────────────────── */
  .boundary-inner {
    padding: clamp(28px, 3.5vw, 44px);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--navy);
    border-radius: 0 var(--r-lg) var(--r-lg) 0;
  }
  .boundary-title {
    font-size: var(--fs-h3);
  }
  .boundary-body {
    margin-top: var(--sp-4);
    max-width: 760px;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.85;
  }
  .boundary-actions {
    margin-top: var(--sp-6);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 600px) {
    .patent {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
