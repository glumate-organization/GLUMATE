---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { products } from '../lib/assets';
import { links } from '../lib/links';

const title = '제품 — 글루메이트 (GLUMATE)';
const description =
  '글루메이트가 만드는 제품을 소개합니다. 첫 번째 제품은 연속혈당측정(CGM) 데이터와 일상의 기록을 이어 생활습관 관리를 돕는 웰니스 앱 글루밍입니다.';

// 제품의 기능·화면 같은 서비스 내용은 제품 사이트(gluming.app)에 둔다.
// 여기(회사 사이트)는 "무엇을 만들고 있는지"만 알리고 넘긴다.
const gluming = products[0];
---

<Layout title={title} description={description}>
  <section class="page">
    <div class="page-grid-bg" aria-hidden="true"></div>
    <div class="container">
      <span class="eyebrow intro" style="--i:0">Products — 제품</span>
      <h1 class="page-title">
        <span class="line" style="--i:0"><span>몸의 데이터를</span></span>
        <span class="line" style="--i:1"><span class="accent">하루의 선택으로</span></span>
      </h1>

      <article class="card intro" style="--i:1">
        <div class="card-head">
          <div>
            <span class="status">{gluming.statusLabel}</span>
            <h2 class="name">
              {gluming.name}<span class="en">{gluming.nameEn}</span>
            </h2>
            <p class="tagline">{gluming.tagline}</p>
          </div>
          {
            gluming.logo && (
              <Image
                class="logo"
                src={gluming.logo}
                alt="글루밍 로고"
                width={260}
                height={76}
                densities={[1, 2]}
              />
            )
          }
        </div>

        <p class="summary">{gluming.summary}</p>

        <p class="pointer">
          더 자세히 보고 싶으시면 제품 사이트 <strong>gluming.app</strong>에서 확인하실 수 있습니다.
        </p>

        <div class="actions">
          <a
            href={links.glumingSite}
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer">gluming.app 바로가기 ↗</a
          >
          <a
            href={links.appStore}
            class="btn btn-ghost"
            target="_blank"
            rel="noopener noreferrer">App Store ↗</a
          >
          <a
            href={links.playStore}
            class="btn btn-ghost"
            target="_blank"
            rel="noopener noreferrer">Google Play ↗</a
          >
        </div>
      </article>

      <p class="note">
        글루밍은 생활습관 관리를 돕는 웰니스 서비스입니다. 질병을 진단하거나 치료하지 않으며,
        의료진의 진료를 대체하지 않습니다.
      </p>
    </div>
  </section>
</Layout>

<style>
  .page {
    position: relative;
    padding: clamp(56px, 7vw, 92px) 0 clamp(72px, 9vw, 120px);
    overflow: hidden;
  }
  .page-grid-bg {
    position: absolute;
    inset: 0;
    background-image: var(--grid-light);
    background-size: 64px 64px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 72%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 72%);
    pointer-events: none;
  }
  .page .container {
    position: relative;
  }
  .page-title {
    font-size: var(--fs-h1);
    letter-spacing: -0.042em;
  }
  .page-title .accent {
    color: var(--navy);
  }

  .card {
    margin-top: var(--sp-8);
    max-width: 760px;
    padding: clamp(28px, 3.4vw, 40px);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--navy);
    border-radius: 0 0 var(--r-md) var(--r-md);
  }
  .card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-6);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px;
    border: 1px solid var(--navy-line);
    border-radius: var(--r-pill);
    background: var(--navy-tint);
    color: var(--navy);
    font-size: 12px;
    font-weight: 700;
  }
  .status::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--navy);
  }
  .name {
    margin-top: var(--sp-4);
    font-size: clamp(26px, 3.4vw, 38px);
    letter-spacing: -0.045em;
  }
  .en {
    margin-left: 11px;
    color: var(--text-3);
    font-size: 0.52em;
    font-weight: 600;
    letter-spacing: 0;
  }
  .tagline {
    margin-top: 8px;
    color: var(--navy);
    font-size: var(--fs-h4);
    font-weight: 700;
  }
  .logo {
    width: 150px;
    height: auto;
    flex: 0 0 auto;
    margin-top: 4px;
  }
  .summary {
    margin-top: var(--sp-6);
    color: var(--text-2);
    font-size: 15.5px;
    line-height: 1.85;
  }
  .pointer {
    margin-top: var(--sp-5);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule);
    color: var(--text);
    font-size: 15px;
  }
  .pointer strong {
    color: var(--navy);
  }
  .actions {
    margin-top: var(--sp-5);
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .note {
    margin-top: var(--sp-6);
    max-width: 760px;
    color: var(--text-3);
    font-size: 13px;
    line-height: 1.75;
  }

  @media (max-width: 720px) {
    .card-head {
      flex-direction: column;
    }
    .logo {
      order: -1;
      width: 130px;
      margin-top: 0;
    }
  }
</style>
