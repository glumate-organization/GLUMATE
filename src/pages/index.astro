---
import { Image } from 'astro:assets';
import { url } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import Honors from '../components/Honors.astro';
import Compare from '../components/Compare.astro';
import { logos, products } from '../lib/assets';
import { company } from '../lib/company';
import { ipPortfolio, ipTotals, patentAreas, patentSummary } from '../lib/credentials';
import { links } from '../lib/links';
import { mailto } from '../lib/mail';

const title = '글루메이트 (GLUMATE) — 더 많은 사람들이 건강하게 살 수 있는 세상을';
const description =
  '글루메이트는 연속혈당측정 데이터를 일상의 행동으로 잇는 헬스케어 소프트웨어 회사입니다. 특허·상표·디자인 출원과 캐릭터 저작권 등록으로 기술과 브랜드를 지키고, ㈜아이센스와 개발 파트너십을 맺었으며, 청년창업사관학교 16기에 선정되었습니다.';

// 히어로 제목 — 줄 단위로 마스크 리빌된다
const heroLines = ['더 많은 사람들이', '건강하게 살 수 있는', '세상을 만듭니다'];

const gluming = products[0];
---

<Layout title={title} description={description}>
  <!-- ─── 1. HERO ─────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow intro" style="--i:0">GLUMATE · 글루메이트</span>
        <h1 class="hero-title">
          {
            heroLines.map((line, i) => (
              <span class="line" style={`--i:${i}`}>
                <span class:list={{ accent: i === 1 }}>{line}</span>
              </span>
            ))
          }
        </h1>
        <p class="hero-lead intro" style="--i:1">
          글루메이트는 연속혈당측정(CGM) 데이터를 일상의 행동으로 잇는 소프트웨어를 만듭니다.
          숫자를 더 보여주는 대신, 오늘 무엇을 하면 좋을지 스스로 알 수 있도록 돕습니다.
        </p>
        <div class="hero-actions intro" style="--i:2">
          <a href={url('/technology')} class="btn btn-primary">기술 보기</a>
          <a href={url('/about')} class="btn btn-ghost">회사 소개</a>
        </div>
      </div>

      <!-- 명판(nameplate) — 스크롤에 따라 살짝 어긋나게 움직인다.
           등장(.intro)과 패럴랙스는 서로 다른 요소에 건다. 같은 요소에 걸면
           JS가 쓰는 인라인 transform 이 CSS 등장 transform 을 덮어써 버린다. -->
      <div class="plate-wrap intro" style="--i:3">
        <div class="plate" data-parallax="-0.12">
          <div class="plate-grid" aria-hidden="true"></div>
          <Image
            class="plate-logo"
            src={logos.verticalWhite}
            alt="글루메이트 GLUMATE 로고"
            width={420}
            height={197}
            densities={[1, 2]}
            loading="eager"
          />
          <p class="plate-sub">{company.slogan}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 2. 선정 · 파트너십 ───────────────────────────── -->
  <section class="section-tight honors-section">
    <div class="container">
      <SectionHead eyebrow="01 · Recognition" variant="split">
        바깥에서 먼저 확인받았습니다
        <Fragment slot="sub">
          공공 창업 지원 프로그램에 선정되었고, 연속혈당측정 센서를 만드는 회사와 함께 개발하고 있습니다.
        </Fragment>
      </SectionHead>
      <div data-reveal>
        <Honors />
      </div>
    </div>
  </section>

  <!-- ─── 3. 기술 (핀 구간) ────────────────────────────── -->
  <section class="tech" data-pin>
    <div class="tech-grid-bg" aria-hidden="true"></div>
    <div class="pin-viewport">
      <div class="pin-track" data-pin-track>
        <div class="tech-panel">
          <span class="eyebrow eyebrow-light">02 · Technology</span>
          <h2 class="tech-title">기술로 증명합니다</h2>
          <p class="tech-sub">
            혈당 데이터를 해석하는 방법에 대해 특허 {patentSummary.count}건을 출원했습니다.
            {patentSummary.filedLabel}, 지금은 심사가 진행 중입니다.
          </p>
          <a href={url('/technology')} class="btn btn-on-dark tech-cta">기술 자세히 보기</a>
        </div>

        {
          patentAreas.map((p) => (
            <article class="tech-card">
              <span class="tech-no">{p.no}</span>
              <span class="tech-area">{p.area}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }

        <div class="tech-summary">
          <p class="tech-summary-label">지식재산</p>
          <p class="tech-summary-num">{ipTotals.all}<span>건</span></p>
          <ul class="tech-ip">
            {
              ipPortfolio.items.map((i) => (
                <li class:list={{ 'is-registered': i.status === 'registered' }}>
                  <span>{i.kind}</span>
                  <b>{i.count}</b>
                  <em>{i.status === 'registered' ? '등록' : '출원'}</em>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 4. 접근 방식 ─────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="03 · Approach" variant="split">
        같은 하루, 알게 되는 시점이 다릅니다
        <Fragment slot="sub">
          몸에 관한 숫자는 이미 충분히 많습니다. 우리는 그 숫자가 다음 선택에 쓰일 수 있도록,
          알게 되는 시점을 행동 뒤에서 행동 앞으로 옮깁니다.
        </Fragment>
      </SectionHead>
      <div data-reveal>
        <Compare />
      </div>
    </div>
  </section>

  <!-- ─── 5. 제품 ──────────────────────────────────────── -->
  <section class="section product-section">
    <div class="container">
      <SectionHead eyebrow="04 · Products" variant="split">
        기술이 사용자에게 닿는 자리
        <Fragment slot="sub">
          지금까지의 기술은 웰니스 앱 글루밍에 담겨 있습니다.
        </Fragment>
      </SectionHead>

      <article class="product" data-reveal>
        <div class="product-body">
          <div class="product-head">
            <span class="status">{gluming.statusLabel}</span>
            <h3 class="product-name">
              {gluming.name} <span class="product-en">{gluming.nameEn}</span>
            </h3>
          </div>
          <p class="product-tagline">{gluming.tagline}</p>
          <p class="product-summary">{gluming.summary}</p>
          <p class="product-pointer">
            기능과 사용 방법은 제품 사이트 gluming.app에서 확인하실 수 있습니다.
          </p>
          <div class="product-actions">
            <a
              href={links.glumingSite}
              class="btn btn-primary"
              target="_blank"
              rel="noopener noreferrer">gluming.app 바로가기 ↗</a
            >
            <a href={url('/products')} class="btn btn-ghost">제품 개요</a>
          </div>
        </div>

        <div class="product-shots" aria-hidden="true">
          <div class="shot shot-1" data-parallax="0.1">
            <Image src={gluming.shots![0].img} alt={`글루밍 앱 화면, ${gluming.shots![0].caption}`} width={300} height={650} densities={[1, 2]} />
          </div>
          <div class="shot shot-2" data-parallax="-0.12">
            <Image src={gluming.shots![1].img} alt={`글루밍 앱 화면, ${gluming.shots![1].caption}`} width={300} height={650} densities={[1, 2]} />
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ─── 6. 문의 한 줄 ────────────────────────────────── -->
  <section class="section-tight">
    <div class="container mail-line" data-reveal>
      <p class="mail-text">
        함께 만들 이야기가 있으신가요? {company.email}로 문의 메일을 보내 주시면 빠르게 답해 드릴게요.
      </p>
      <a href={mailto('협업 문의')} class="btn btn-ghost">메일 보내기</a>
    </div>
  </section>
</Layout>

<style>
  /* ── HERO ─────────────────────────────────────────── */
  .hero {
    position: relative;
    padding: clamp(56px, 7vw, 100px) 0 clamp(56px, 6vw, 88px);
    overflow: hidden;
  }
  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image: var(--grid-light);
    background-size: 64px 64px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 82%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 82%);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .hero-title {
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    letter-spacing: -0.045em;
  }
  .hero-title .accent {
    color: var(--navy);
  }
  .hero-lead {
    margin-top: var(--sp-6);
    max-width: 520px;
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
  }
  .hero-actions {
    margin-top: var(--sp-7);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .plate {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(36px, 4.5vw, 60px) clamp(24px, 3vw, 44px);
    background: linear-gradient(160deg, var(--navy-deep), var(--navy-ink));
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .plate-grid {
    position: absolute;
    inset: 0;
    background-image: var(--grid-dark);
    background-size: 48px 48px;
  }
  .plate-logo {
    position: relative;
    width: min(100%, 320px);
    height: auto;
  }
  .plate-sub {
    position: relative;
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule-dark);
    max-width: 340px;
    color: var(--on-dark-2);
    font-size: 13.5px;
    line-height: 1.75;
    text-align: center;
  }

  /* ── 기술 (핀 구간) ───────────────────────────────── */
  .tech {
    position: relative;
    /* 100vh 는 고정 뷰포트, 나머지가 가로 이동에 쓰이는 스크롤 거리다 */
    height: 260vh;
    background: var(--navy-ink);
  }
  .tech-grid-bg {
    position: absolute;
    inset: 0;
    background-image: var(--grid-dark);
    background-size: 64px 64px;
    pointer-events: none;
  }
  .tech .pin-track {
    padding-inline: max(24px, calc((100vw - var(--maxw)) / 2));
    align-items: stretch;
    /* 고정된 높이를 줘야 카드가 화면을 채우고 '멈춰 선' 느낌이 산다 */
    height: min(50vh, 380px);
  }
  .tech-panel {
    flex: 0 0 auto;
    width: clamp(300px, 30vw, 420px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-right: clamp(12px, 2vw, 28px);
  }
  .tech-title {
    color: #fff;
    font-size: clamp(30px, 3.6vw, 46px);
    letter-spacing: -0.04em;
  }
  .tech-sub {
    margin-top: var(--sp-5);
    color: var(--on-dark-2);
    font-size: 15.5px;
    line-height: 1.8;
  }
  .tech-cta {
    margin-top: var(--sp-7);
    align-self: flex-start;
  }

  .tech-card {
    position: relative;
    flex: 0 0 auto;
    width: clamp(280px, 27vw, 380px);
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 2.6vw, 36px);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid var(--rule-dark);
    border-radius: var(--r-lg);
    transition: background var(--dur-2) var(--ease), border-color var(--dur-2) var(--ease);
  }
  .tech-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
  }
  .tech-no {
    color: rgba(168, 189, 218, 0.55);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
  }
  .tech-area {
    display: inline-block;
    margin-top: 18px;
    padding: 4px 11px;
    align-self: flex-start;
    border: 1px solid var(--rule-dark);
    border-radius: var(--r-pill);
    color: var(--on-dark-accent);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tech-card h3 {
    /* 카드가 세로로 길어도 비어 보이지 않게 본문은 아래로 붙인다 */
    margin-top: auto;
    padding-top: 24px;
    color: #fff;
    font-size: clamp(19px, 1.9vw, 23px);
  }
  .tech-card p {
    margin-top: 14px;
    color: var(--on-dark-2);
    font-size: 14.5px;
    line-height: 1.8;
  }

  .tech-summary {
    flex: 0 0 auto;
    width: clamp(220px, 20vw, 300px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(26px, 2.6vw, 36px);
    border: 1px dashed rgba(255, 255, 255, 0.28);
    border-radius: var(--r-lg);
  }
  .tech-summary-label {
    color: var(--on-dark-accent);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .tech-summary-num {
    margin-top: var(--sp-2);
    color: #fff;
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .tech-summary-num span {
    margin-left: 4px;
    font-size: var(--fs-h4);
    letter-spacing: 0;
  }
  .tech-ip {
    list-style: none;
    margin: var(--sp-5) 0 0;
    padding: 0;
    border-top: 1px solid var(--rule-dark);
  }
  .tech-ip li {
    display: grid;
    grid-template-columns: 1fr auto 40px;
    align-items: baseline;
    gap: var(--sp-3);
    padding: var(--sp-2) 0;
    border-bottom: 1px solid var(--rule-dark);
    color: var(--on-dark-2);
    font-size: var(--fs-sm);
  }
  .tech-ip b {
    color: #fff;
    font-size: var(--fs-h4);
    font-variant-numeric: tabular-nums;
  }
  .tech-ip em {
    justify-self: end;
    padding: 1px 8px;
    border: 1px dashed var(--rule-dark);
    border-radius: var(--r-pill);
    font-size: 11px;
    font-style: normal;
    font-weight: 700;
  }
  .tech-ip .is-registered em {
    border: 1px solid var(--on-dark-accent);
    background: var(--on-dark-accent);
    color: var(--navy-ink);
  }

  /* ── 제품 ─────────────────────────────────────────── */
  .product-section {
    background: var(--surface-2);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .product {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    padding: clamp(28px, 4vw, 52px);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
  }
  .product-head {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px;
    border: 1px solid var(--navy-line);
    border-radius: var(--r-pill);
    background: var(--navy-tint);
    color: var(--navy);
    font-size: 12px;
    font-weight: 700;
  }
  .status::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--navy);
  }
  .product-name {
    font-size: clamp(24px, 3vw, 34px);
  }
  .product-en {
    color: var(--text-3);
    font-size: 0.62em;
    font-weight: 600;
    letter-spacing: 0;
  }
  .product-tagline {
    margin-top: var(--sp-4);
    color: var(--navy);
    font-size: var(--fs-h4);
    font-weight: 700;
  }
  .product-summary {
    margin-top: var(--sp-3);
    color: var(--text-2);
    font-size: 15.5px;
    line-height: 1.8;
  }
  .product-pointer {
    margin-top: var(--sp-5);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule);
    color: var(--text);
    font-size: 15px;
  }
  .product-actions {
    margin-top: var(--sp-7);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .product-shots {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 16px;
    min-height: 300px;
  }
  .shot :global(img) {
    width: 100%;
    height: auto;
    border-radius: 18px;
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-md);
  }
  .shot-1 {
    width: 46%;
  }
  .shot-2 {
    width: 46%;
  }

  /* ── 선정 · 파트너십 ─────────────────────────────── */
  .honors-section {
    padding-top: 0;
  }

  /* ── 문의 한 줄 ───────────────────────────────────── */
  .mail-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    padding: var(--sp-6) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .mail-text {
    color: var(--text);
    font-size: var(--fs-lead);
  }

  /* ── 반응형 ───────────────────────────────────────── */
  @media (max-width: 980px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .plate-wrap {
      order: -1;
    }
    .plate {
      padding: 32px 24px;
    }
    .plate-logo {
      width: min(100%, 260px);
    }
    .product {
      grid-template-columns: 1fr;
    }
    .product-shots {
      order: -1;
      max-width: 420px;
      margin-inline: auto;
    }
  }

  /* 좁은 화면에서는 핀을 풀고 그냥 세로로 쌓는다 */
  @media (max-width: 899px) {
    .tech {
      height: auto;
      padding: var(--section-y) 0;
    }
    .tech .pin-viewport {
      position: static;
      height: auto;
      display: block;
      overflow: visible;
    }
    .tech .pin-track {
      flex-direction: column;
      padding-inline: 24px;
      height: auto;
    }
    .tech-panel,
    .tech-card,
    .tech-summary {
      width: 100%;
      padding-right: 0;
    }
    .tech-panel {
      padding-bottom: 8px;
    }
    .tech-summary {
      padding: 28px;
    }
  }

</style>
